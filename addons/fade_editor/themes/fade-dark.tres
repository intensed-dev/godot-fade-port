; ---------------------------------------------------------------------------
; Surfaces and controls.
; ---------------------------------------------------------------------------

Panel/styles/panel = SubResource("StyleBoxFlat_panel")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
PopupPanel/styles/panel = SubResource("StyleBoxFlat_panel_raised")
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_panel")
LineEdit/styles/normal = SubResource("StyleBoxFlat_field")
LineEdit/styles/focus = SubResource("StyleBoxFlat_field_focus")
LineEdit/styles/read_only = SubResource("StyleBoxFlat_field")
SpinBox/styles/normal = SubResource("StyleBoxFlat_field")
SpinBox/styles/focus = SubResource("StyleBoxFlat_field_focus")
OptionButton/styles/normal = SubResource("StyleBoxFlat_button")
OptionButton/styles/hover = SubResource("StyleBoxFlat_button_hover")
OptionButton/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
MenuButton/styles/normal = SubResource("StyleBoxFlat_button")
MenuButton/styles/hover = SubResource("StyleBoxFlat_button_hover")
MenuButton/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
TabBar/styles/tab_selected = SubResource("StyleBoxFlat_tab_selected")
TabContainer/styles/tab_selected = SubResource("StyleBoxFlat_tab_selected")
TabContainer/styles/panel = SubResource("StyleBoxFlat_panel")
Tree/styles/selected = SubResource("StyleBoxFlat_button_pressed")
Tree/styles/selected_focus = SubResource("StyleBoxFlat_button_pressed")
Tree/styles/cursor = SubResource("StyleBoxFlat_field_focus")
ItemList/styles/selected = SubResource("StyleBoxFlat_button_pressed")
ItemList/styles/selected_focus = SubResource("StyleBoxFlat_button_pressed")

; ---------------------------------------------------------------------------
; Editor-specific style resources. These are the surfaces used by Godot's
; editor shell, not just the controls inside an individual project.
; ---------------------------------------------------------------------------

EditorStyles/styles/Background = SubResource("StyleBoxFlat_editor_background")
EditorStyles/styles/PanelForeground = SubResource("StyleBoxFlat_panel")
EditorStyles/styles/Content = SubResource("StyleBoxFlat_editor_background")
EditorStyles/styles/BottomPanel = SubResource("StyleBoxFlat_panel")
EditorStyles/styles/ContextualToolbar = SubResource("StyleBoxFlat_panel_raised")
EditorStyles/styles/ScriptEditor = SubResource("StyleBoxFlat_editor_background")
EditorStyles/styles/DebuggerPanel = SubResource("StyleBoxFlat_panel")
