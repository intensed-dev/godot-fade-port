default_font = SubResource("SystemFont_roboto")

; ---------------------------------------------------------------------------
; Shared editor palette — Unreal-inspired charcoal surfaces and blue accent.
; ---------------------------------------------------------------------------

Editor/colors/base_color = Color(0.075, 0.08, 0.09, 1)
Editor/colors/accent_color = Color(0.28, 0.52, 0.78, 1)
Editor/colors/font_focus_color = Color(0.96, 0.97, 0.99, 1)
